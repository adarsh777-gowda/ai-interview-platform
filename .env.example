# Database (Neon, Supabase, or local Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/ai_interview?schema=public"

# Auth.js / NextAuth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
ACCESS_PASSWORD="change-this-password"
SHARED_USER_EMAIL="shared@interviewai.local"


# AI provider (any OpenAI-compatible API)
#
# FREE default — Groq (no credit card, generous free tier):
#   1. Get a free key at https://console.groq.com/keys
#   2. Paste it below
OPENAI_BASE_URL="https://api.groq.com/openai/v1"
OPENAI_API_KEY="gsk_..."
OPENAI_MODEL="openai/gpt-oss-20b"

# Alternative free provider — Google Gemini (AI Studio):
#   1. Get a free key at https://aistudio.google.com/apikey
#   OPENAI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
#   OPENAI_API_KEY="AIza..."
#   OPENAI_MODEL="gemini-2.5-flash"

# OpenRouter free models (JSON mode may be unavailable — the app auto-retries without it):
#   OPENAI_BASE_URL="https://openrouter.ai/api/v1"
#   OPENAI_API_KEY="sk-or-..."
#   OPENAI_MODEL="meta-llama/llama-3.3-70b-instruct:free"

# OpenAI (paid — leave OPENAI_BASE_URL unset):
#   OPENAI_API_KEY="sk-..."
#   OPENAI_MODEL="gpt-4o-mini"

# Rate limiting (requests per window)
AI_RATE_LIMIT_MAX=10
AI_RATE_LIMIT_WINDOW_MS=60000
